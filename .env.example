# Copy to .env locally. Never commit real values.

# Private Admin Supplies. Keep disabled until PalDefender is configured on the
# dedicated server with a token limited to REST.Items.Give and
# REST.Progression.Give. The target player remains fixed below.
ADMIN_SUPPLIES_ENABLED=false
ADMIN_SUPPLIES_TRANSPORT=rest
PALDEFENDER_URL=
PALDEFENDER_TOKEN=
PALCOMMAND_RCON_HELPER=
ADMIN_SUPPLY_PLAYER_ID=
ADMIN_SUPPLY_MAX_COUNT=999999
ADMIN_SUPPLY_MAX_PROGRESSION=10000
OLLAMA_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=embeddinggemma
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_KEEP_ALIVE=30s
OLLAMA_EMBED_KEEP_ALIVE=30s

# Repeated local answers persist for 7 days. Web and live answers expire sooner.
ANSWER_CACHE_TTL_SECONDS=604800
ANSWER_CACHE_WEB_TTL_SECONDS=3600
ANSWER_CACHE_LIVE_TTL_SECONDS=15
VOICE_CACHE_PATH=data/private/voice-cache

# Optional live Palworld context (read-only endpoints).
PALWORLD_REST_URL=
PALWORLD_ADMIN_PASSWORD=

# Optional web retrieval.
BRAVE_SEARCH_API_KEY=

# Optional Discord surface.
DISCORD_TOKEN=
# DISCORD_GUILD_ID=
