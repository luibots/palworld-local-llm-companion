# Copy to .env locally. Never commit real values.
OLLAMA_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:14b
OLLAMA_EMBED_MODEL=embeddinggemma

# Optional live Palworld context (read-only endpoints).
PALWORLD_REST_URL=http://127.0.0.1:8212
PALWORLD_ADMIN_PASSWORD=replace-locally

# Optional web retrieval.
BRAVE_SEARCH_API_KEY=replace-locally

# Optional Discord surface.
DISCORD_TOKEN=replace-locally
DISCORD_GUILD_ID=replace-locally
